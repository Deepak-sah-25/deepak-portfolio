# Django Production Environment Variables
# Copy this to .env or set these in your hosting provider's Dashboard (Render, Railway, Fly.io, VPS, etc.)

# Secret Key (generate a secure random 50+ character string)
SECRET_KEY=django-insecure-replace-this-in-production-with-a-secure-secret-key

# Set DEBUG to False for production
DEBUG=False

# Allowed hosts (comma-separated domain names or IPs)
# e.g., ALLOWED_HOSTS=deepaksah.com.np,deepak-portfolio.onrender.com,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app

# CSRF Trusted Origins for forms (comma-separated with https://)
# e.g., CSRF_TRUSTED_ORIGINS=https://deepaksah.com.np,https://deepak-portfolio.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.railway.app

# Database URL (Optional: If omitted, Django automatically uses SQLite3. If provided, uses PostgreSQL)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Enable SSL Redirect (Set to True if you have HTTPS configured and want Django to enforce it)
# ENABLE_SSL_REDIRECT=False
